# Copy to .env and fill in values from your Appwrite project.
# See README.md for full setup instructions.

# --- Shared (safe to expose to the browser bundle; no secrets here) ---
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=

# Base URL this app is served from. Used to build the email verification
# redirect link, and must be registered as a Web platform in your Appwrite
# project (Overview -> Platforms) or verification requests will be rejected.
VITE_APP_URL=http://localhost:3000

# --- Server-only (read by the running app; never sent to the browser) ---
# IDs of the database/tables created by `npm run setup:schema`. Must match
# the values that script was run with (see APPWRITE_TABLE_* below).
APPWRITE_DATABASE_ID=hauz
APPWRITE_TABLE_ACCOUNTS_ID=accounts
APPWRITE_TABLE_ACCOUNT_ACCESS_GRANTS_ID=account_access_grants
APPWRITE_TABLE_PERSONAL_ACCOUNTS_ID=personal_accounts
APPWRITE_TABLE_PERSONAL_ROLES_ID=personal_roles

# $id of the deployed "register-personal-account" Appwrite Function
# (see functions/register-personal-account and the README's deploy steps).
APPWRITE_FUNCTION_REGISTER_PERSONAL_ACCOUNT_ID=

# --- Setup-script-only (never read by the running app) ---
# API key used solely by `npm run setup:schema` to create the database,
# tables, attributes, indexes, and seed the personal_roles rows. Needs the
# databases.read and databases.write scopes. Do not set this anywhere the
# running app can read it; scripts/setup-schema.ts loads it independently
# on purpose.
APPWRITE_API_KEY=
